     def __init__(self):
 
         super().__init__()
-        self._server_url = '/var/run/docker.sock'
+        # resolved lazily in connector() so that a bad DOCKER_HOST value is reported
+        # when Docker is actually used and not when this manager is instantiated
+        self._server_url = None
         self._connected = False
         # Allow locking during ubridge operations
         self.ubridge_lock = asyncio.Lock()
         self._connector = None
         self._session = None
         self._api_version = DOCKER_MINIMUM_API_VERSION
+        self._rootless = False
+
+    @property
+    def rootless(self):
+        """
+        :returns: True if the Docker daemon runs in rootless mode
+        """
+
+        return self._rootless
+
+    @staticmethod
+    def _docker_socket_path():
+        """
+        Get the path of the Docker daemon Unix socket.
+
+        The default system-wide socket can be overridden with the DOCKER_HOST
+        environment variable, which is required to use a rootless Docker daemon
+        (its socket usually lives in $XDG_RUNTIME_DIR/docker.sock).
+
+        :returns: path to the Docker Unix socket
+        """
+
+        docker_host = os.environ.get("DOCKER_HOST", "").strip()
+        if not docker_host:
+            return DEFAULT_DOCKER_SOCKET_PATH
+
+        if docker_host.startswith("unix://"):
+            socket_path = docker_host[len("unix://"):]
+        elif docker_host.startswith("/"):
+            # tolerate a bare path, even though Docker itself requires a scheme
+            socket_path = docker_host
+        else:
+            raise DockerError(f"DOCKER_HOST is set to '{docker_host}' but only Unix sockets are "
+                              f"supported, e.g. unix:///run/user/1000/docker.sock")
+
+        if not socket_path:
+            raise DockerError(f"DOCKER_HOST is set to '{docker_host}' but contains no socket path")
+
+        log.info(f"Using Docker socket '{socket_path}' from the DOCKER_HOST environment variable")
+        return socket_path
 
